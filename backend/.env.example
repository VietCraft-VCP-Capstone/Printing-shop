# ============================================================
# PRINTING SHOP BACKEND - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================

# Service Port
PORT=8880

# MongoDB Atlas (Can share cluster or use dedicated printing DB)
MONGO_URI=mongodb+srv://<username>:<password>@vietcraft.eupxy2t.mongodb.net/printing?appName=VietCraft

# URL of VietCraft Backend for Inbound Webhooks
# In production: https://api.yourdomain.com (or internal docker: http://vietcraft-backend:8080)
VIETCRAFT_BE_URL=https://api.yourdomain.com

# Google Client ID for Portal Auth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT Secret for Factory Staff Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your_printing_jwt_secret_here_min_32_characters

# ============================================================
# VIETCRAFT CONNECTION KEYS
# ============================================================
# Shared API key for receiving orders from VietCraft (Must match PRINTER_API_KEY in VietCraft BE)
PRINTING_SHOP_API_KEY=your_shared_printing_shop_api_key_2026

# Shared HMAC secret for signing webhooks sent to VietCraft (Must match PRINTER_WEBHOOK_SECRET in VietCraft BE)
PRINTING_WEBHOOK_SECRET=your_shared_printing_webhook_hmac_secret_2026
