# ============================================================
# PRINTING SHOP FRONTEND - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================

# Printing Shop Backend API Base URL
# If deployed on Vercel: https://api-printer.yourdomain.com
# If behind same domain/reverse proxy: leave blank (defaults to /api proxy)
VITE_API_URL=https://api-printer.yourdomain.com

# VietCraft Backend API URL (Used to resolve design image assets)
VITE_VIETCRAFT_BE_URL=https://api.yourdomain.com

# VietCraft Main Frontend URL (Used for "Sang Cổng Seller" external links)
VITE_VIETCRAFT_FE_URL=https://yourdomain.com
